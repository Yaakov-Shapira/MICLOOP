# Firebase — copy from Firebase Console > Project Settings > Your apps
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# LiveKit Cloud — copy from livekit.io dashboard
EXPO_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# Cloud Functions (server-side only — NEVER put these here!)
# Put LIVEKIT_API_KEY and LIVEKIT_API_SECRET in functions/.env.local only
